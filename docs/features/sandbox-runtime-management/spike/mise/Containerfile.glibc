FROM docker.io/library/debian:12-slim

# mise needs curl/git/ca-certs; xz to unpack tool tarballs. No Nix, no daemon.
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends curl git ca-certificates xz-utils \
 && rm -rf /var/lib/apt/lists/*

# Bake the mise binary (pinned, glibc static-ish musl-or-gnu) into the image. Pinned to an exact
# release so the build never hits GitHub's version-listing API (rate-limited to 60 req/h
# unauthenticated, returns 403 — the same failure flox's HEAD resolution hit). Bump to upgrade mise.
ARG MISE_VERSION=v2026.6.14
RUN curl -fsSL "https://github.com/jdx/mise/releases/download/${MISE_VERSION}/mise-${MISE_VERSION}-linux-x64.tar.gz" \
    | tar xz -C /usr/local --strip-components=1 mise/bin/mise

ENV MISE_DATA_DIR=/root/.local/share/mise \
    MISE_LOCKFILE=1 \
    MISE_YES=1

# Bake the in-app web terminal engine (zellij) and symlink it onto the global PATH, exactly like the
# flox base did: terminal runs plain `zellij` over `podman exec`, not through any per-sandbox env.
# Pinned to an exact version so the install skips the rate-limited GitHub releases-list API. zellij
# >= 0.43.0 is required for the `zellij web` subcommand the terminal depends on.
ARG ZELLIJ_VERSION=0.44.3
RUN mise install "zellij@${ZELLIJ_VERSION}" \
 && ln -sf "$(mise where zellij@${ZELLIJ_VERSION})/zellij" /usr/local/bin/zellij \
 && zellij --version

# zellij web aborts with "Failed to find default config file path" unless a config exists.
RUN mkdir -p /root/.config/zellij \
 && zellij setup --dump-config > /root/.config/zellij/config.kdl

CMD ["/bin/sh"]
