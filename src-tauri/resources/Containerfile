FROM docker.io/library/debian:12-slim

# mise fetches tools over HTTPS (curl), some backends clone repos (git), xz unpacks tool tarballs.
# A glibc base (not Alpine/musl) is deliberate: mise installs prebuilt upstream release binaries and
# glibc-only language runtimes (e.g. Node from nodejs.org) fail on musl — and mise's musl-node
# workarounds compile from source. See docs/features/sandbox-runtime-management/02_dev.md.
# procps provides the `ps` binary paseo's own `daemon status`/`stop` shell out to
# (they crash with `spawn ps ENOENT` without it — docs/features/agent-web-ui/02_dev.md).
# socat is a general-purpose TCP tool; e2e/test/specs/standard/expose-port.spec.ts runs it as the
# throwaway in-sandbox server it exposes.
# openssh-server backs the podman-exec-transport reachability model: the host's outer ssh/Mutagen
# client tunnels through `podman exec -i <sandbox> sshd -i`, so no port is ever published — see
# docs/features/podman-exec-transport/02_dev.md.
# tini is the container's PID 1 (see ENTRYPOINT below): it reaps the `sshd -i` processes that
# `podman exec` leaves reparented to PID 1 once their sessions close.
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends curl git ca-certificates xz-utils procps socat tini openssh-server \
 && rm -rf /var/lib/apt/lists/*

# Static sshd config for the podman-exec-transport model: `sshd -i` reads it via `-f` and needs no
# Port/ListenAddress in inetd mode. `StrictModes no` is load-bearing: AuthorizedKeysFile arrives via
# `podman cp` from Windows, whose permission bits sshd would otherwise reject as too open.
# Host keys are baked at build time — they identify sshd to the client, not the reverse, and a
# `podman exec` pipe has no network path for a third party to intercept.
# The `mio-sshd` launcher exists for its `mkdir`: sshd aborts without /run/sshd, and /run is a fresh
# tmpfs at container start, so the directory cannot be baked in. ensure_sandbox_alias execs it.
# The sftp subsystem is not optional here: Mutagen installs its remote agent with `scp`, which
# speaks the SFTP protocol, and this config replaces Debian's default rather than extending it.
# ClientAlive* is what ends a forwarding `sshd -i` whose client died without a disconnect: `podman
# exec` does not propagate the client's death, so the keepalive probe is the only signal (about
# 45 seconds of silence).
RUN ssh-keygen -A \
 && printf '%s\n' \
    'AuthorizedKeysFile /etc/ssh/authorized_keys.container' \
    'PasswordAuthentication no' \
    'PubkeyAuthentication yes' \
    'StrictModes no' \
    'ClientAliveInterval 15' \
    'ClientAliveCountMax 3' \
    'UsePAM no' \
    'Subsystem sftp /usr/lib/openssh/sftp-server' \
    > /etc/ssh/sshd_config.container \
 && touch /etc/ssh/authorized_keys.container \
 && printf '%s\n' \
    '#!/bin/sh' \
    'mkdir -p /run/sshd' \
    'exec /usr/sbin/sshd -i -f /etc/ssh/sshd_config.container' \
    > /usr/local/bin/mio-sshd \
 && chmod +x /usr/local/bin/mio-sshd

# Bake the mise binary into the image so `create` pays no download. Pinned to an exact release so the
# build never hits GitHub's version-listing API (rate-limited to 60 req/h unauthenticated, returns
# 403 — the same failure flox's HEAD resolution hit). Bump MISE_VERSION to upgrade mise.
ARG MISE_VERSION=v2026.6.14
RUN curl -fsSL "https://github.com/jdx/mise/releases/download/${MISE_VERSION}/mise-${MISE_VERSION}-linux-x64.tar.gz" \
    | tar xz -C /usr/local --strip-components=1 mise/bin/mise

# MISE_LOCKFILE=1 makes installs maintain mise.lock (only when the lockfile already exists, which the
# runtime's init creates). MISE_YES auto-confirms so `podman exec` never blocks on a prompt.
# SHELL=bash makes zellij open bash panes (which read .bashrc) instead of /bin/sh.
ENV MISE_DATA_DIR=/root/.local/share/mise \
    MISE_LOCKFILE=1 \
    MISE_YES=1 \
    SHELL=/bin/bash

# Bake the in-app web terminal engine (zellij) and symlink it onto the global PATH so the terminal
# runs plain `zellij` over `podman exec`, NOT through mise. Pinned to an exact version so the install
# skips the rate-limited GitHub releases-list API; zellij >= 0.43.0 is required for the `zellij web`
# subcommand the terminal depends on. Bump ZELLIJ_VERSION (verify >= 0.43.0) to upgrade zellij.
ARG ZELLIJ_VERSION=0.44.3
RUN mise install "zellij@${ZELLIJ_VERSION}" \
 && ln -sf "$(mise where zellij@${ZELLIJ_VERSION})/zellij" /usr/local/bin/zellij \
 && zellij --version

# The web server aborts with "Failed to find default config file path" unless a config exists, so
# dump the default config into the location zellij resolves at startup.
RUN mkdir -p /root/.config/zellij \
 && zellij setup --dump-config > /root/.config/zellij/config.kdl

# Activate mise in interactive bash sessions so zellij terminal panes have installed tools on PATH.
RUN echo 'eval "$(mise activate bash)"' > /root/.bashrc

# Default to the workspace directory so the zellij daemon (and the panes it spawns) start where
# mise.toml lives, letting mise resolve the right tool versions without an explicit `cd`.
WORKDIR /root/work

# PID 1 must reap: without tini, exited `sshd -i` sessions linger as zombies for the container's
# lifetime. Podman-only — microsandbox boots its own guest init and does not run the image's
# ENTRYPOINT or CMD (docs/features/microsandbox-network-policy/spike/04_msb-mitm-sidecar.md).
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/bash"]
