{
  "name": "e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:light": "wdio run wdio.conf.ts --suite light",
    "test:standard": "wdio run wdio.conf.ts --spec ./test/specs/standard/*.ts",
    "test:heavy": "wdio run wdio.conf.ts --suite heavy",
    "test:llm": "wdio run wdio.conf.ts --spec ./test/specs/light/local-llm-ui.spec.ts",
    "test:activity": "wdio run wdio.conf.ts --spec ./test/specs/heavy/activity-center.spec.ts",
    "test:port": "wdio run wdio.conf.ts --spec ./test/specs/standard/expose-port.spec.ts",
    "test:agentweb": "wdio run wdio.conf.ts --spec ./test/specs/standard/agent-web.spec.ts",
    "test:opencode-forward": "wdio run wdio.conf.ts --spec ./test/specs/heavy/opencode-forward.spec.ts",
    "test:failures": "node -e \"const fs=require('fs');try{const c=fs.readFileSync('failures.log','utf8');process.stdout.write(c||'No failures\\n')}catch{console.log('Run pnpm test first')}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wdio/cli": "9.27.2"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.42",
    "@wdio/globals": "9.27.2",
    "@wdio/local-runner": "9.27.2",
    "@wdio/mocha-framework": "9.27.2",
    "@wdio/spec-reporter": "9.27.2",
    "@wdio/types": "9.27.2",
    "expect-webdriverio": "5.6.7",
    "tsx": "4.22.4",
    "typescript": "5.6.3"
  }
}
