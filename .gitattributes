# Parallel feature branches each add entries to the top of the feature log; a union merge keeps
# both sides instead of conflicting. `./build docs` flags a date section that ends up duplicated.
docs/features/log.md merge=union

# Embedded into the binary and run by sh inside a sandbox, so a CRLF checkout would break them.
src-tauri/resources/agent-host/*.sh text eol=lf
